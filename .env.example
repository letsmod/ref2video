# Template for .env -- copy to .env and fill in the keys you actually need.
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# You only need a key for the provider you run with. An exported shell variable
# of the same name always overrides what is set here.

# https://cloud.segmind.com/console/api-keys
SEGMIND_API_KEY=SG_your_key_here

# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_key_here

# https://fal.ai/dashboard/keys
FAL_KEY=your_key_id:your_key_secret
